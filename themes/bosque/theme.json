{
  "$schema": "https://raw.githubusercontent.com/develoverli/tv-launcher-themes/main/schema/theme.schema.json",
  "schemaVersion": 1,
  "id": "bosque",
  "name": "Bosque",
  "author": "adb-tv-studio",
  "version": "1.1.0",
  "layout": "classic",
  "description": "El diseño clásico sobre un degradado verde profundo.",
  "colors": {
    "background": "#08130D",
    "surface": "#11241A",
    "text": "#EEF4EE",
    "accent": "auto"
  },
  "background": {
    "type": "gradient",
    "colors": [
      "#183A28",
      "#060D09"
    ],
    "angle": 160
  },
  "material": "glass",
  "shape": "rounded",
  "focus": "lift",
  "font": "outfit",
  "motion": "smooth",
  "labels": "focus",
  "clock": {
    "visible": true,
    "size": "normal"
  },
  "columns": 4,
  "glow": true
}
