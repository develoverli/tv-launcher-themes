{
  "$schema": "https://raw.githubusercontent.com/develoverli/tv-launcher-themes/main/schema/theme.schema.json",
  "schemaVersion": 1,
  "id": "retro",
  "name": "Retro",
  "author": "adb-tv-studio",
  "version": "1.1.0",
  "layout": "grid",
  "description": "Cuadrícula de esquinas rectas, letra monoespaciada y colores de consola vieja.",
  "colors": {
    "background": "#1A1424",
    "surface": "#2A2138",
    "text": "#F3E6C8",
    "accent": "#FF7A3D"
  },
  "background": {
    "type": "solid"
  },
  "material": "solid",
  "shape": "square",
  "focus": "outline",
  "font": "mono",
  "motion": "none",
  "labels": "always",
  "clock": {
    "visible": true,
    "size": "normal"
  },
  "columns": 5,
  "glow": false
}
