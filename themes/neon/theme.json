    "angle": 135
  },
  "material": "glass",
  "shape": "round",
  "focus": "glow",
  "font": "condensed",
  "motion": "springy",
  "labels": "focus",
  "clock": {
    "visible": true,
    "size": "large"
  },
  "columns": 3,
