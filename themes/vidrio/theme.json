{
  "$schema": "https://raw.githubusercontent.com/develoverli/tv-launcher-themes/main/schema/theme.schema.json",
  "schemaVersion": 1,
  "id": "vidrio",
  "name": "Vidrio",
  "author": "adb-tv-studio",
  "version": "1.1.0",
  "layout": "rows",
  "description": "Vidrio translúcido sobre grafito cálido y un foco que levanta la tarjeta.",
  "colors": {
    "background": "#101113",
    "surface": "#1D1F23",
    "text": "#F4F4F2",
    "accent": "auto"
  },
  "background": {
    "type": "gradient",
    "colors": [
      "#2A2B2F",
      "#0C0D0F"
    ],
    "angle": 170
  },
  "material": "glass",
  "shape": "round",
  "focus": "lift",
  "font": "sans",
  "motion": "smooth",
  "labels": "focus",
  "clock": {
    "visible": true,
    "size": "normal"
  },
  "columns": 4,
  "glow": true
}
