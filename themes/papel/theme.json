{
  "$schema": "https://raw.githubusercontent.com/develoverli/tv-launcher-themes/main/schema/theme.schema.json",
  "schemaVersion": 1,
  "id": "papel",
  "name": "Papel",
  "author": "adb-tv-studio",
  "version": "1.1.0",
  "layout": "grid",
  "description": "Claro y cálido, con letra serif, para salas con mucha luz.",
  "colors": {
    "background": "#F2ECE1",
    "surface": "#E4DACA",
    "text": "#241F1A",
    "accent": "#A8482B"
  },
  "background": {
    "type": "solid"
  },
  "material": "solid",
  "shape": "rounded",
  "focus": "outline",
  "font": "serif",
  "motion": "smooth",
  "labels": "always",
  "clock": {
    "visible": true,
    "size": "normal"
  },
  "columns": 4,
  "glow": false
}
